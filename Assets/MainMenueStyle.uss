.header {
    font-size: 100px;
    color: rgb(255, 255, 255);
    padding-top: 0;
    padding-left: 59px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Lato-Black.ttf?fileID=12800000&guid=4baeba46effff4b708e6d1b9e2897996&type=3#Lato-Black");
    margin-top: 34px;
}

.button_small {
    font-size: 60px;
    color: rgb(0, 73, 72);
    width: 465px;
    align-items: stretch;
    justify-content: flex-start;
    align-self: center;
    height: 400px;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    background-color: rgb(225, 233, 236);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Lato-Bold.ttf?fileID=12800000&guid=ed257a039e5204e67948c2d48688c195&type=3#Lato-Bold");
    background-position-y: center 0;
    -unity-text-align: middle-left;
    padding-top: 189px;
    padding-left: 133px;
    margin-top: 0;
    top: 0;
    margin-bottom: 40px;
    margin-right: 20px;
    flex-direction: row;
    margin-left: 20px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.button_big {
    font-size: 60px;
    color: rgb(0, 73, 72);
    width: 950px;
    align-items: stretch;
    justify-content: flex-start;
    align-self: center;
    height: 400px;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    background-color: rgb(225, 233, 236);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Lato-Bold.ttf?fileID=12800000&guid=ed257a039e5204e67948c2d48688c195&type=3#Lato-Bold");
    background-position-y: center 0;
    -unity-text-align: middle-left;
    padding-top: 230px;
    padding-left: 42px;
    margin-top: 0;
    top: 0;
    margin-bottom: 586px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.searchBar {
    -unity-text-outline-color: rgba(180, 9, 9, 0);
}
