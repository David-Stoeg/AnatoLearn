                <ui:VisualElement name="slider" style="flex-grow: 1; position: absolute; width: 220px; height: 220px; border-top-left-radius: 120px; border-top-right-radius: 120px; border-bottom-right-radius: 120px; border-bottom-left-radius: 120px; background-color: rgb(225, 233, 236); padding-left: 0; margin-left: -9px;" />
